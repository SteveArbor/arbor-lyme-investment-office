# Arbor Lyme Capital — environment variables
#
# Copy this file to .env.local and fill in real values. Never commit
# .env.local or any file containing real values — see .gitignore.
#
# This file lists only the variables the Foundation milestone actually
# uses. See docs/implementation/foundation.md for which variables were
# deliberately deferred (SUPABASE_SERVICE_ROLE_KEY, CRON_SECRET) and why.

# --- Public (browser-safe) ---
# Inlined into the client bundle at build time. Never put a secret here.

# Your Supabase project URL. Found in Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon/publishable key. Safe for the browser — Row-Level
# Security policies, not this key, are what enforce access control.
# Note: Supabase is transitioning terminology from "anon key" to
# "publishable key" — use whichever your project's API settings page shows
# for the public/client-side key; the value goes in this same variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The application's own public URL (used for auth redirect links and
# metadata). Local development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only ---
# None required by the Foundation milestone. Do not add
# SUPABASE_SERVICE_ROLE_KEY or CRON_SECRET until a phase that actually
# uses them (see docs/development-roadmap.md) — an unused secret sitting in
# every developer's .env.local is exposure with no benefit.
